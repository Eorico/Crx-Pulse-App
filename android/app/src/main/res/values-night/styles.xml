<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme applied to the Android Window while the process is starting,
      when the OS's Dark Mode setting is ON.

      CRX-Pulse has no dark theme: the app is light-only, and its first
      in-app screen is a white splash. So the launch window is forced
      white here too, instead of inheriting a black one from
      Theme.Black.NoTitleBar — otherwise a dark-mode phone opened on
      black and then flashed to white.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!--
      Theme applied to the Android Window as soon as the process has
      started: the colour behind the Flutter UI while it initialises,
      and behind it while running. White for the same reason.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
